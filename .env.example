# ============================================================
# VPS uchun namuna. Nusxasini `.env` deb saqlang va toʻldiring.
#   cp .env.example .env
#
# ⚠️ `.env` git'ga TUSHMAYDI. Parollarni chatga yoki koddagi
#    faylga yozmang.
# ============================================================

# --- Domen ---
# Caddy shu nom uchun HTTPS sertifikat oladi. DNS A-record VPS
# IP manziliga yoʻnaltirilgan boʻlishi SHART, aks holda sertifikat
# olinmaydi.
DOMAIN=musobaqa.robbitonline.uz

# Ilova host'da qaysi portda tursin. Serverda boshqa reverse proxy
# (Caddy/nginx) 80/443 ni band qilgan boʻlsa, oʻsha proxy shu portga
# yoʻnaltiriladi.
APP_PORT=4600

# --- Baza ---
POSTGRES_DB=qara
POSTGRES_USER=qara_app
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Ilova ---
# Kamida 32 belgi. openssl rand -base64 32
SESSION_SECRET=

# Admin panel paroli. Musobaqa kuni check-in stoli va jerebyovka
# shu parol ostida turadi — oddiy soʻz qoʻymang.
ADMIN_PASSWORD=

# --- Zaxira (ixtiyoriy) ---
# BACKUP_INTERVAL_SECONDS=600
# BACKUP_KEEP=48
