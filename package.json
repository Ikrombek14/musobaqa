{
  "name": "musobaqa-jerebrovka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:migrate:ci": "tsx scripts/migrate.ts",
    "db:seed:ci": "tsx scripts/seed.ts",
    "verify:draw": "tsx scripts/verify-draw.ts",
    "verify:numbering": "tsx --env-file=.env.local scripts/verify-numbering.ts",
    "verify:progression": "node --import tsx --conditions=react-server --env-file=.env.local scripts/verify-progression.ts",
    "start:e2e": "node --env-file=.env.local ./node_modules/next/dist/bin/next start -p 3100",
    "start:e2e:ci": "next start -p 3100",
    "e2e": "playwright test",
    "verify": "npm run verify:draw && npm run verify:numbering && npm run verify:progression"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
